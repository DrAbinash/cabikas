# B. K. & Co., Chartered Accountants — website Environment Configuration
# Copy to .env (next to docker-compose.yml) and adjust as needed.
# Without a .env file the defaults below apply.

# Password for the /admin page where site details are edited (phone, email,
# address, ICAI membership number, office hours, notice banner, photograph).
# CHANGE THIS before deploying.
ADMIN_PASSWORD=changeme123

# Host-side port the NAS publishes the site on — the left-hand number in the
# "ports:" line of docker-compose.yml. Must be unique per project on the NAS
# and must match the reverse-proxy target (Caddyfile / DSM reverse-proxy rule).
# hope-neurotrauma-website uses 3008; this site defaults to 3009.
HOST_PORT=3009

# Note: the public URL (https://www.bikas.caredeoghar.com) is baked into the
# static files (canonical tag, sitemap.xml, robots.txt) — no environment
# variable controls it. If the domain ever changes, update those files and
# rebuild. Everything else shown on the site is editable from /admin.
